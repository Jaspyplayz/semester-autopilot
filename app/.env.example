# Optional. Turns on "Read with Claude instead". The app works fully without it.
# Without auth, anyone who can open the site can spend this key: see README.md.
# ANTHROPIC_API_KEY=

# Local testing only, and ignored on Vercel. Lets the app reach http:// and private
# addresses, which the mock Canvas site in scripts/mock-canvas.ts needs. Never set
# this on a public deployment: it turns off the protection against server-side
# request forgery.
# CANVAS_ALLOW_PRIVATE_HOSTS=1
